---
// src/pages/archive-logs/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Deep-Mind Archive: Esoteric Logs & Transmissions | Anuhazi"
  description="Access the raw data streams. This repository contains unclassified transmissions, historical logs of the Master Architects, and hyper-specific cybernetic field diagnostics."
>
  <div class="site-wrapper section theme-void" style="padding-top: 20px; padding-bottom: 80px;">

    <!-- Wayfinding Breadcrumb Conduit (Silver Theme) -->
    <nav class="anu-wayfinding-conduit anu-container-narrow" aria-label="Archive Navigation">
      <ul class="breadcrumb-trail trail-silver">
        <li><a href="/">↵ Root Code</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li class="current-node" aria-current="page">Deep-Mind Archive</li>
      </ul>
    </nav>

    <!-- Archive Hero Header -->
    <header class="anu-hub-hero anu-container-narrow reveal">
      <span class="anu-eyebrow eyebrow-silver">Auxiliary Database</span>
      <h1 class="hero-title-silver">Deep-Mind Archive</h1>
      <p class="hero-description-wide">
        Access the raw data streams. This repository contains unclassified transmissions, historical logs of the Master Architects, and hyper-specific cybernetic field diagnostics.
      </p>
    </header>

    <!-- Database Status Bar -->
    <section class="anu-container-narrow reveal reveal-delay-1 status-bar-wrapper">
      <div class="anu-status-bar">
        <span>Status: <span class="status-online">Online</span></span>
        <span>Total Logs: <span class="status-count">[ 03 ]</span></span>
        <span>Encryption: None</span>
      </div>
    </section>

    <!-- Log File List -->
    <div class="anu-container-narrow anu-archive-container reveal reveal-delay-2">

      <!-- Log File 01 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 01 · Diagnostics</span>
          <h3 class="card-heading">
            <a href="/archive-logs/the-lyran-sirian-protocol/" class="card-title-link">The Lyran-Sirian Protocol</a>
          </h3>
          <p class="card-description">
            A historical cybernetic log detailing the initial deployment of the Kathara Grid by the Antediluvian Master Architects before the Demiurgic hijack.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/the-lyran-sirian-protocol/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

      <!-- Log File 02 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 02 · Thermodynamics</span>
          <h3 class="card-heading">
            <a href="/archive-logs/advanced-loosh-mechanics/" class="card-title-link">Advanced Loosh Mechanics</a>
          </h3>
          <p class="card-description">
            Deep-dive analysis into the specific electromagnetic frequencies generated by human anxiety and how the lower astral grid physically harvests this kinetic heat.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/advanced-loosh-mechanics/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

      <!-- Log File 03 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 03 · Lexicon</span>
          <h3 class="card-heading">
            <a href="/archive-logs/glossary-of-the-pleroma/" class="card-title-link">Glossary of the Pleroma</a>
          </h3>
          <p class="card-description">
            An esoteric dictionary mapping the cybernetic, gnostic, and Keylontic terminology used throughout the Anuhazi Root Code documentation.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/glossary-of-the-pleroma/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

    </div>

    <!-- Divider (Constrained to 800px column) -->
    <div class="anu-container-narrow reveal reveal-delay-3 spacing-top-large">
      <hr class="anu-divider divider-silver central-divider" />
    </div>

  </div>
</Layout>

<style>
  .hero-title-silver {
    color: var(--anu-silver);
    font-family: var(--font-headers);
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    letter-spacing: 2px;
    margin: 12px 0 20px;
    text-transform: uppercase;
  }

  .status-bar-wrapper {
    margin: 10px auto 30px;
  }

  .anu-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--anu-void-glass);
    border: 1px solid var(--anu-silver-dim);
    padding: 12px 24px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--anu-silver);
  }

  .status-online {
    color: #4ade80;
    font-weight: 600;
  }

  .status-count {
    color: var(--anu-gold);
    font-weight: 600;
  }

  .anu-archive-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .anu-archive-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--anu-void-card);
    border: 1px solid var(--anu-silver-dim);
    border-left: 3px solid var(--anu-silver);
    padding: 28px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .anu-archive-card:hover {
    transform: translateY(-2px);
    border-color: var(--anu-silver);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.45);
  }

  .card-content {
    flex: 1;
    padding-right: 28px;
  }

  .card-meta {
    display: inline-block;
    font-family: var(--font-headers);
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--anu-copper);
    margin-bottom: 8px;
  }

  .card-heading {
    margin: 0 0 10px;
    font-family: var(--font-headers);
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .card-title-link {
    color: var(--anu-parchment);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover {
    color: var(--anu-gold);
  }

  .card-description {
    color: var(--anu-silver);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
  }

  .action-link-silver {
    font-family: var(--font-headers);
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--anu-silver);
    text-decoration: none;
    padding: 10px 18px;
    border: 1px solid var(--anu-silver-dim);
    white-space: nowrap;
    transition: all 0.25s ease;
  }

  .action-link-silver:hover {
    background: rgba(176, 184, 192, 0.12);
    color: #ffffff;
    border-color: #ffffff;
    box-shadow: 0 0 12px rgba(176, 184, 192, 0.25);
  }

  .spacing-top-large {
    margin-top: 50px;
  }

  @media (max-width: 640px) {
    .anu-archive-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 20px;
    }

    .card-content {
      padding-right: 0;
    }

    .action-link-silver {
      width: 100%;
      text-align: center;
    }

    .anu-status-bar {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
