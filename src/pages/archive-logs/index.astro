---
// src/pages/archive-logs/index.astro
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Deep-Mind Archive: Esoteric Logs & Transmissions | Anuhazi"
  description="Access the raw data streams. This repository contains unclassified transmissions, historical logs of the Master Architects, and hyper-specific cybernetic field diagnostics."
>
  <div class="site-wrapper section theme-void" style="padding-top: 20px; padding-bottom: 80px;">

    <!-- Wayfinding Breadcrumb Conduit (Silver Theme) -->
    <nav class="anu-wayfinding-conduit anu-wayfinding-conduit-narrow" aria-label="Archive Navigation">
      <ul class="breadcrumb-trail trail-silver">
        <li><a href="/">↵ Root Code</a></li>
        <li class="separator" aria-hidden="true">/</li>
        <li class="current-node" aria-current="page">Deep-Mind Archive</li>
      </ul>
    </nav>

    <!-- Archive Hero Header -->
    <header class="anu-archive-hero reveal">
      <span class="anu-eyebrow eyebrow-silver">Auxiliary Database</span>
      <h1 class="hero-title-silver">Deep-Mind Archive</h1>
      <p class="hero-description-wide">
        Access the raw data streams. This repository contains unclassified transmissions, historical logs of the Master Architects, and hyper-specific cybernetic field diagnostics.
      </p>
    </header>

    <!-- Database Status Bar -->
    <section class="reveal reveal-delay-1 status-bar-wrapper">
      <div class="anu-status-bar">
        <span>Status: <span class="status-online">Online</span></span>
        <span>Total Logs: <span class="status-count">[ 03 ]</span></span>
        <span>Encryption: None</span>
      </div>
    </section>

    <!-- Log File List -->
    <div class="anu-container anu-archive-container reveal reveal-delay-2">

      <!-- Log File 01 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 01 · Diagnostics</span>
          <h3 class="card-heading">
            <a href="/archive-logs/the-lyran-sirian-protocol/" class="card-title-link">The Lyran-Sirian Protocol</a>
          </h3>
          <p class="card-description">
            A historical cybernetic log detailing the initial deployment of the Kathara Grid by the Antediluvian Master Architects before the Demiurgic hijack.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/the-lyran-sirian-protocol/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

      <!-- Log File 02 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 02 · Thermodynamics</span>
          <h3 class="card-heading">
            <a href="/archive-logs/advanced-loosh-mechanics/" class="card-title-link">Advanced Loosh Mechanics</a>
          </h3>
          <p class="card-description">
            Deep-dive analysis into the specific electromagnetic frequencies generated by human anxiety and how the lower astral grid physically harvests this kinetic heat.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/advanced-loosh-mechanics/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

      <!-- Log File 03 -->
      <article class="anu-archive-card">
        <div class="card-content">
          <span class="card-meta">Log File 03 · Lexicon</span>
          <h3 class="card-heading">
            <a href="/archive-logs/glossary-of-the-pleroma/" class="card-title-link">Glossary of the Pleroma</a>
          </h3>
          <p class="card-description">
            An esoteric dictionary mapping the cybernetic, gnostic, and Keylontic terminology used throughout the Anuhazi Root Code documentation.
          </p>
        </div>
        <div class="card-action">
          <a href="/archive-logs/glossary-of-the-pleroma/" class="action-link-silver">Decrypt &rarr;</a>
        </div>
      </article>

    </div>

    <hr class="anu-divider central-divider reveal reveal-delay-3 spacing-top-large" />

  </div>
</Layout>

<style>
  .hero-title-silver {
    color: var(--anu-silver, #a8b2c1);
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 2px;
    margin: 12px 0 16px;
  }

  .status-bar-wrapper {
    max-width: 800px;
    margin: 24px auto 40px;
    padding: 0 16px;
  }

  .anu-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(168, 178, 193, 0.05);
    border: 1px solid rgba(168, 178, 193, 0.2);
    padding: 10px 18px;
    border-radius: 3px;
    font-family: var(--font-body, 'Montserrat', sans-serif);
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--anu-silver, #a8b2c1);
  }

  .status-online {
    color: #4ade80;
    font-weight: 600;
  }

  .status-count {
    color: var(--anu-gold, #c5a059);
    font-weight: 600;
  }

  .anu-archive-container {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .anu-archive-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--anu-void-card, #09101d);
    border: 1px solid rgba(168, 178, 193, 0.2);
    padding: 24px;
    border-radius: 4px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .anu-archive-card:hover {
    transform: translateY(-2px);
    border-color: var(--anu-silver, #a8b2c1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .card-content {
    flex: 1;
    padding-right: 24px;
  }

  .card-meta {
    display: inline-block;
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: 0.75rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--anu-copper, #c87d55);
    margin-bottom: 6px;
  }

  .card-heading {
    margin: 4px 0 10px;
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: 1.25rem;
  }

  .card-title-link {
    color: var(--anu-parchment, #e6ded0);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .card-title-link:hover {
    color: var(--anu-gold, #c5a059);
  }

  .card-description {
    color: var(--anu-silver, #a8b2c1);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  .action-link-silver {
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: 0.85rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--anu-silver, #a8b2c1);
    text-decoration: none;
    padding: 8px 16px;
    border: 1px solid rgba(168, 178, 193, 0.3);
    border-radius: 2px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .action-link-silver:hover {
    background: rgba(168, 178, 193, 0.15);
    color: #ffffff;
    border-color: #ffffff;
  }

  .spacing-top-large {
    margin-top: 60px;
  }

  @media (max-width: 640px) {
    .anu-archive-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }

    .card-content {
      padding-right: 0;
    }

    .anu-status-bar {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>